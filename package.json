{
  "name": "vastel",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "clean": "cd android && ./gradlew clean && cd ..",
    "start": "react-native start --reset-cache",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "gaa": "cd android && ./gradlew clean && cd .. && npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && cd android && ./gradlew assembleDebug",
    "gar": "cd android && ./gradlew assembleRelease",
    "postinstall": "npx typesync"
  },
  "dependencies": {
    "@react-native-community/clipboard": "^1.5.1",
    "@react-navigation/bottom-tabs": "^6.4.3",
    "@react-navigation/native": "^6.0.13",
    "@react-navigation/native-stack": "^6.9.1",
    "@twotalltotems/react-native-otp-input": "^1.3.11",
    "agora-react-native-rtm": "^1.5.1",
    "agora-rn-uikit": "^4.0.0",
    "react": "18.1.0",
    "react-native": "0.70.5",
    "react-native-agora": "^3.7.1",
    "react-native-animatable": "^1.3.3",
    "react-native-communications": "^2.2.1",
    "react-native-dotenv": "^3.4.2",
    "react-native-multibar": "^1.1.5",
    "react-native-pager-view": "^6.1.1",
    "react-native-paper": "^4.12.5",
    "react-native-phone-number-input": "^2.1.0",
    "react-native-safe-area-context": "^4.4.1",
    "react-native-screens": "^3.18.2",
    "react-native-simple-toast": "^1.1.4",
    "react-native-tab-view": "^3.3.0",
    "react-native-vector-icons": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/runtime": "^7.12.5",
    "@react-native-community/eslint-config": "^2.0.0",
    "@tsconfig/react-native": "^2.0.2",
    "@types/babel__core": "^7.1.20",
    "@types/eslint": "^8.4.10",
    "@types/jest": "^26.0.23",
    "@types/react": "^18.0.21",
    "@types/react-native": "^0.70.6",
    "@types/react-native-communications": "^2.2.1",
    "@types/react-native-dotenv": "^0.2.0",
    "@types/react-native-vector-icons": "^6.4.12",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.37.0",
