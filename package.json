{
  "name": "vastel",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build": "cd android && ./gradlew build && cd ..",
    "clean": "cd android && ./gradlew clean && cd ..",
    "uninstall": "cd android && ./gradlew uninstallAll && cd ..",
    "start": "react-native start --reset-cache",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "gaa": "cd android && ./gradlew clean && cd .. && npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && cd android && ./gradlew assembleDebug",
    "gar": "cd android && ./gradlew assembleRelease && cd ..",
    "gab": "cd android && ./gradlew bundleRelease && cd ..",
    "postinstall": "npx typesync",
    "android:dev": "react-native run-android --variant=developmentdebug",
    "android:dev-release": "react-native run-android --variant=developmentrelease",
    "android:staging": "react-native run-android --variant=stagingdebug",
    "android:staging-release": "react-native run-android --variant=stagingrelease",
    "android:prod": "react-native run-android --variant=productiondebug",
    "android:prod-release": "react-native run-android --variant=productionrelease"
  },
  "dependencies": {
