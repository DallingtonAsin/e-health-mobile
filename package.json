  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build": "cd android && ./gradlew build && cd ..",
    "clean": "cd android && ./gradlew clean && cd ..",
    "uninstall": "cd android && ./gradlew uninstallAll && cd ..",
    "start": "react-native start --reset-cache",
    "port-8082": "node node_modules/react-native/local-cli/cli.js start --port 8082",
    "test": "jest",
    "deploy": "ssh -p 22 vastel@207.180.244.124",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "gaa": "cd android && ./gradlew clean && cd .. && npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && cd android && ./gradlew assembleDebug",
    "gar": "cd android && ./gradlew clean && cd .. && npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && rm -rf  android/app/src/main/res/drawable-* && cd android && ./gradlew assembleRelease",
    "gab": "cd android && ./gradlew bundleRelease && cd ..",
    "postinstall": "npx typesync",
    "debug-build": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/ && cd android && ./gradlew assembleDebug && cd ..",
    "release-build": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/build/intermediates/res/merged/release/ && rm -rf android/app/src/main/res/drawable-* && rm -rf android/app/src/main/res/raw/* && cd android && ./gradlew assembleRelease && cd ..",
    "android:dev": "react-native run-android --variant=developmentdebug",
    "android:dev-release": "react-native run-android --variant=developmentrelease",
    "android:staging": "react-native run-android --variant=stagingdebug",
    "android:staging-release": "react-native run-android --variant=stagingrelease",
    "android:prod": "react-native run-android --variant=productiondebug",
    "android:prod-release": "react-native run-android --variant=productionrelease",
    "android:release": "react-native run-android --variant=release",
    "memory:clear": "free -h && sudo sysctl -w vm.drop_caches=3 && sudo sync && echo 3 | sudo tee /proc/sys/vm/drop_caches && free -h",
    "upgrade-gradle": "cd android && ./gradlew wrapper --gradle-version=7.6.1 --distribution-type=bin && ./gradlew tasks && cd .."
  },
